# Copy to .env and fill in. .env is gitignored — never commit real values.

# From @BotFather
BOT_TOKEN=123456789:AA...replace-me
BOT_USERNAME=ExpenseParser

# Only this Telegram user ID may talk to the bot. Get yours by messaging @userinfobot.
ALLOWED_USER_ID=000000000

# The expense tracker API. It runs on the Pi itself (outside Docker), so the
# container reaches it via host.docker.internal, which docker-compose.yml maps
# to the host gateway. Change the port if your API listens elsewhere.
API_BASE_URL=http://host.docker.internal:3100
